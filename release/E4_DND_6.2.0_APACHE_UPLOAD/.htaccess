# E4 D&D SPA + PWA Apache example
# Review with your hosting provider before production use.

RewriteEngine On

# Preserve real files and directories.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA deep-route fallback.
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # Never aggressively cache the mutable application shell.
  <FilesMatch "^(index\.html|manifest\.webmanifest|sw\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Hashed assets may be cached long-term.
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
